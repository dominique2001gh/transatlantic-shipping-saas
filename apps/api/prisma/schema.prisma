// Transatlantic Shipping SaaS — core data model
//
// MULTI-TENANCY: every tenant-owned operational table carries a `tenantId`
// column with an index, even where it is technically reachable through a
// parent relation. This is deliberate defense-in-depth: application code
// (see src/common/tenant) can filter and validate directly on tenantId
// without having to walk relation chains, and it is impossible to
// construct a query that "forgets" to scope a join.
//
// PLATFORM_ADMIN users have tenantId = null and are the only role allowed
// to operate across tenants (tenant management only, not tenant data).
//
// ITEM-LEVEL OPERATIONS (Milestone 3): a Shipment and a ShipmentItem are
// different things. A shipment is the customer-facing unit ("your
// shipment TAL-2026-001234"); a ShipmentItem is one physical, independently
// scannable piece inside it (a box, a barrel, a vehicle...). Container
// loading, receiving, and tracking events all operate at the ShipmentItem
// level so the system can answer "3 of 4 items have arrived" precisely.
// Shipment.status and ShipmentItem.status are denormalized "current state"
// columns for fast reads; TrackingEvent is the append-only source of truth
// for history — never overwritten, only appended to.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================================
// ENUMS
// ==========================================================================

enum UserRole {
  PLATFORM_ADMIN
  TENANT_OWNER
  TENANT_ADMIN
  WAREHOUSE_MANAGER
  WAREHOUSE_STAFF
  CUSTOMER_SERVICE
  ACCOUNTANT
  DESTINATION_AGENT
  DRIVER
  CUSTOMER
}

enum ShipmentMode {
  AIR
  OCEAN_LCL
  OCEAN_FCL
  RORO
}

/// Coarse, customer-facing shipment status. Denormalized onto
/// Shipment.status for fast reads; kept intentionally simpler than the
/// operational TrackingEventType vocabulary below.
enum ShipmentStatus {
  DRAFT
  QUOTE_REQUESTED
  AWAITING_ITEMS
  WAREHOUSE_RECEIVED
  PROCESSING
  READY_FOR_CONSOLIDATION
  CONSOLIDATED
  BOOKED
  LOADED
  DEPARTED
  IN_TRANSIT
  ARRIVED_DESTINATION
  CUSTOMS_PROCESSING
  CUSTOMS_CLEARED
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ShipmentItemType {
  BOX
  BARREL
  PALLET
  CRATE
  VEHICLE
  MACHINERY
  HOUSEHOLD_GOODS
  OTHER
}

/// Physical workflow status of one ShipmentItem — distinct from
/// ShipmentStatus. A shipment can be WAREHOUSE_RECEIVED overall while one
/// of its items is still REGISTERED (not yet physically dropped off).
enum ShipmentItemStatus {
  REGISTERED
  RECEIVED_ORIGIN_WAREHOUSE
  MEASURED
  PROCESSED
  CONSOLIDATED
  ASSIGNED_TO_CONTAINER
  /// Air-freight equivalent of ASSIGNED_TO_CONTAINER (Milestone 3E) —
  /// used only for items assigned directly to a Manifest with no
  /// intermediate Container, so the air-freight path never needs to
  /// borrow the ocean-container status. Assignment itself is a later
  /// controlled step; this value is added now for schema completeness.
  ASSIGNED_TO_MANIFEST
  LOADED
  DEPARTED_ORIGIN
  IN_TRANSIT
  ARRIVED_DESTINATION
  RECEIVED_DESTINATION_WAREHOUSE
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  PICKED_UP
  EXCEPTION
  CANCELLED
}

enum DimensionUnit {
  IN
  CM
}

enum WeightUnit {
  LB
  KG
}

enum ContainerType {
  TWENTY_FT
  FORTY_FT
  FORTY_FT_HIGH_CUBE
  OTHER
}

enum ContainerStatus {
  BOOKED
  LOADING
  LOADED
  DEPARTED
  IN_TRANSIT
  ARRIVED
  CUSTOMS_HOLD
  UNLOADING
  CLOSED
}

enum ManifestStatus {
  DRAFT
  FINALIZED
  /// Milestone 3E-A adds this value to complete the schema now; the
  /// depart action itself (transition + roll-forward) is a deliberately
  /// separate, later controlled step — see Manifest.departedAt below.
  DEPARTED
  /// Milestone 3F: the whole transport movement has landed at
  /// destination — see Manifest.arrivedAt below. Distinct from any
  /// individual item being physically received at a destination
  /// warehouse (ShipmentItemStatus.RECEIVED_DESTINATION_WAREHOUSE),
  /// which happens per-item, later, and asynchronously.
  ARRIVED
  SUBMITTED
  ARCHIVED
}

enum VehicleTitleStatus {
  CLEAN
  SALVAGE
  REBUILT
  LIEN
  BILL_OF_SALE_ONLY
  UNKNOWN
}

/// The operational audit-trail vocabulary for TrackingEvent — deliberately
/// more granular than ShipmentStatus, and covers both shipment-level and
/// item-level events (see TrackingEvent.shipmentItemId).
enum TrackingEventType {
  SHIPMENT_CREATED
  ITEM_REGISTERED
  RECEIVED_AT_WAREHOUSE
  MEASURED
  PROCESSED
  CONSOLIDATED
  ASSIGNED_TO_CONTAINER
  REMOVED_FROM_CONTAINER
  /// Air-freight direct-assignment equivalents of
  /// ASSIGNED_TO_CONTAINER/REMOVED_FROM_CONTAINER (Milestone 3E).
  ASSIGNED_TO_MANIFEST
  REMOVED_FROM_MANIFEST
  LOADED
  DEPARTED_ORIGIN
  IN_TRANSIT
  ARRIVED_DESTINATION
  RECEIVED_DESTINATION_WAREHOUSE
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  PICKED_UP
  /// A failed/incomplete delivery attempt that came back to a destination
  /// warehouse and is eligible for a fresh dispatch or a walk-in pickup —
  /// distinct from RECEIVED_DESTINATION_WAREHOUSE (the item's status after
  /// this event is the same value, but this event type keeps the history
  /// honest: it was dispatched, didn't arrive, and came back, not that it
  /// was simply received once). See WarehouseService.returnItem.
  RETURNED_TO_WAREHOUSE
  /// Shipment-level: every applicable item reached a terminal successful
  /// handoff (PICKED_UP and/or DELIVERED, any mix). See
  /// WarehouseService.maybeRollupShipmentCompletion. Its own distinct
  /// value rather than reusing PICKED_UP/DELIVERED — a shipment
  /// completed via a mix of both, or via DELIVERED alone, must not read
  /// to a customer as if it were specifically "picked up."
  COMPLETED
  EXCEPTION
  CANCELLED
  NOTE_ADDED
}

/// How a tracking event was captured — lets the audit trail distinguish a
/// warehouse scan from a manual correction or a system-generated entry.
enum TrackingEventSource {
  MANUAL
  BARCODE_SCAN
  QR_SCAN
  SYSTEM
  API
}

/// Controlled vocabulary for the physical condition observed during a
/// warehouse inspection (Milestone 3C). Replaces the free-text
/// ShipmentItem.condition that Milestone 3B left as a placeholder.
enum ShipmentItemCondition {
  GOOD
  MINOR_DAMAGE
  DAMAGED
  REPACKAGED
  OTHER
}

/// Outcome of a warehouse inspection: whether the item may continue
/// forward through the pipeline (READY) or must not (HOLD). This is
/// deliberately the only signal container-loading eligibility should ever
/// need — it maps 1:1 onto ShipmentItemStatus.PROCESSED vs .EXCEPTION, so
/// "is this item eligible to load" is always a single-column check, never
/// a derived combination of condition + result + notes.
enum ItemProcessingResult {
  READY
  HOLD
}

/// Distinguishes the events PickupDeliveryRecord can represent.
/// PICKUP and DELIVERY are the two final-handoff outcomes that feed
/// WarehouseService.maybeRollupShipmentCompletion (see
/// ITEM_TERMINAL_HANDOFF). DISPATCH (Delivery/Driver milestone) is
/// deliberately not a final handoff — it's the courier-assignment record
/// created when an item leaves the warehouse OUT_FOR_DELIVERY, kept as
/// its own immutable row (never edited into a DELIVERY row later) so the
/// original dispatch details survive even after multiple failed/retried
/// attempts.
enum HandoffType {
  PICKUP
  DISPATCH
  DELIVERY
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  CHECK
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

/// Stage 3F: MANUAL (staff-recorded, Stage 3B) vs ONLINE (customer self-service via a payment provider, Stage 3F) — see Payment.source's own doc comment.
enum PaymentSource {
  MANUAL
  ONLINE
}

enum DocumentType {
  BILL_OF_LADING
  INVOICE
  PACKING_LIST
  MANIFEST
  CUSTOMS_FORM
  ID_DOCUMENT
  TITLE_DOCUMENT
  PHOTO
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

/// Stage 3H: what kind of business occurrence produced a NotificationEvent.
/// One value per distinct trigger source in this codebase — see
/// NotificationsService's own doc comment for exactly where each is fired.
enum NotificationEventType {
  SHIPMENT_STATUS_CHANGED
  DOCUMENT_VISIBLE
  INVOICE_ISSUED
  PAYMENT_RECEIVED
  CONTAINER_DISRUPTED
  STAFF_ANNOUNCEMENT
}

/// Stage 3H: the kind of operational disruption staff are reporting on a
/// container/manifest — drives the bulk customer-notification flow.
enum DisruptionType {
  DELAYED
  HELD
  INSPECTED
  IMPOUNDED
  OTHER
}

enum AddressType {
  BILLING
  SHIPPING
  DESTINATION
  ORIGIN
  OTHER
}

/// Website Launch: which public marketing-site form a WebsiteLead came
/// from — the two forms collect different fields (see WebsiteLead's own
/// doc comment), so every consumer needs to know which shape to expect.
enum WebsiteLeadType {
  QUOTE_REQUEST
  CONTACT
}

/// Website Launch: simple staff-managed triage state for a WebsiteLead.
/// Deliberately just enough to track "has anyone looked at this yet" —
/// converting a lead into a real Customer/Quote/Invoice is always a
/// manual staff action through the existing Customers/Quotes flows, never
/// automatic, so there is no CONVERTED value here to keep in sync with
/// anything.
enum WebsiteLeadStatus {
  NEW
  CONTACTED
  CLOSED
}

// ==========================================================================
// PLATFORM / TENANT
// ==========================================================================

/// A tenant is one customer of the SaaS platform (a freight forwarding
/// company). Trans Atlantic Logistics Solutions is tenant #1, not a
/// special case in code.
model Tenant {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  legalName      String?
  email          String
  phone          String?
  website        String?
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  /// AnanseLogix Phase 1: public WhatsApp contact number, configured from
  /// the onboarding wizard's Branding step — separate from `phone` since a
  /// tenant may publish a different number (or none) for WhatsApp vs voice.
  whatsappNumber String?

  /// Public Website AI Agent, Phase 1: the display name a tenant's public
  /// chat widget uses for its assistant (e.g. Trans Atlantic's "Eddie") —
  /// deliberately per-tenant, never hardcoded, so every tenant can name
  /// their own assistant independently. Null means no custom name has been
  /// set yet; PublicAiAgentService falls back to "{tenant.name} Assistant"
  /// in that case rather than requiring a value here.
  agentName String?
  country        String
  timezone       String
  currency       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ------------------------------------------------------------------------
  // AnanseLogix Phase 2 (Section 15): tenant-branded public website config.
  // Deliberately just data on Tenant, not a website-builder — see
  // SiteConfigService's own doc comment. Trans Atlantic's real public site
  // keeps reading its own hardcoded apps/web/src/lib/site-config.ts and
  // never touches any of this; these fields exist purely so a *future*
  // tenant can be served a real branded site from this data, opt-in, with
  // no code changes required when that cutover happens.
  // ------------------------------------------------------------------------
  tagline         String?
  aboutContent    String?
  heroHeadline    String?
  heroSubheadline String?
  serviceTypes    String[]
  facebookUrl     String?
  linkedinUrl     String?
  instagramUrl    String?
  /// Reserved for a future real domain cutover — deliberately unused by any
  /// routing/DNS/deployment logic today (see this section's own header
  /// comment). Nullable + unique so at most one tenant can ever claim a
  /// given domain once this is wired up.
  customDomain    String?  @unique

  settings              TenantSettings?
  users                 User[]
  customers             Customer[]
  addresses             Address[]
  warehouses            Warehouse[]
  routes                Route[]
  shipments             Shipment[]
  shipmentItems         ShipmentItem[]
  itemInspections       ItemInspection[]
  pickupDeliveryRecords PickupDeliveryRecord[]
  vehicleDetails        VehicleDetails[]
  containers            Container[]
  containerItems        ContainerItem[]
  manifests             Manifest[]
  manifestItems         ManifestItem[]
  trackingEvents        TrackingEvent[]
  quotes                Quote[]
  invoices              Invoice[]
  invoiceItems          InvoiceItem[]
  payments              Payment[]
  documents             Document[]
  notifications         Notification[]
  notificationEvents    NotificationEvent[]
  operationalExceptions OperationalException[]
  websiteLeads          WebsiteLead[]

  publicLocations       TenantLocation[]
  agentKnowledgeEntries TenantAgentKnowledgeEntry[]

  subscription         TenantSubscription?
  entitlements         TenantEntitlement[]
  onboarding           TenantOnboarding?
  invitations          TenantInvitation[]
  signupSessions       SignupSession[]
  platformAuditLogsFor PlatformAuditLog[]

  @@map("tenants")
}

/// Per-tenant configuration, including the configurable numbering prefixes
/// referenced throughout the spec (customer numbers, tracking numbers).
model TenantSettings {
  id       String @id @default(cuid())
  tenantId String @unique

  customerNumberPrefix   String @default("CUST")
  customerNumberSequence Int    @default(0)

  trackingNumberPrefix   String @default("SHP")
  trackingNumberSequence Int    @default(0)

  invoiceNumberPrefix   String @default("INV")
  invoiceNumberSequence Int    @default(0)

  manifestNumberPrefix   String @default("MAN")
  manifestNumberSequence Int    @default(0)

  defaultOriginCountry      String?
  defaultDestinationCountry String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// AnanseLogix Phase 2 (Section 15): one entry in a tenant's public-site
/// "Locations" list — display content for a future branded website, not
/// necessarily the same as a Warehouse (a marketing location may be shown
/// without exposing operational warehouse detail, or vice versa). See
/// Tenant's own doc comment on this section for the "data only, not a
/// website builder, opt-in, never touches Trans Atlantic" scope.
model TenantLocation {
  id        String   @id @default(cuid())
  tenantId  String
  label     String
  city      String
  region    String?
  country   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_locations")
}

/// Public Website AI Agent, Phase 1: which kind of knowledge entry this row
/// is — FACT (a labeled topic paragraph, e.g. "Ocean Freight" -> a
/// description) or FAQ (a literal question -> answer pair). Both shapes are
/// stored in the same table with the same two content columns (`title`/
/// `body`) rather than two separate models, since both are fundamentally
/// "a labeled chunk of text the agent may draw from" — see
/// TenantAgentKnowledgeEntry's own doc comment.
enum TenantAgentKnowledgeKind {
  FACT
  FAQ
}

/// Public Website AI Agent, Phase 1: the ONLY knowledge source the public,
/// unauthenticated agent (see apps/api/src/public-ai-agent) is allowed to
/// read from. Deliberately separate from every operational model (Shipment,
/// Customer, Invoice, ...) and from the Section 15 public-site-config
/// fields on Tenant — this is purpose-built for "facts an anonymous website
/// visitor may be told," never anything staff-only or customer-private.
///
/// `kind = FACT`: `title` is a topic label (e.g. "Ocean Freight", "DFW
/// Origin Warehouse"), `body` is the paragraph of real, verified
/// information about it. `kind = FAQ`: `title` is the literal question,
/// `body` is the answer. The agent's system prompt is assembled by
/// concatenating every `isActive` row for the resolved tenant, in
/// `sortOrder` — see PublicAiAgentService's own doc comment. There is
/// deliberately no per-row "confidence"/"source" field in Phase 1; every row
/// is asserted true content a human reviewed before inserting it (see the
/// seed script's own doc comment on Trans Atlantic's initial backfill).
model TenantAgentKnowledgeEntry {
  id        String                   @id @default(cuid())
  tenantId  String
  kind      TenantAgentKnowledgeKind
  title     String
  body      String                   @db.Text
  sortOrder Int                      @default(0)
  isActive  Boolean                  @default(true)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("tenant_agent_knowledge_entries")
}

// ==========================================================================
// USERS / CUSTOMERS
// ==========================================================================

/// A login-capable account. Staff users always have a tenantId; a CUSTOMER
/// user has a tenantId and is linked 1:1 to a Customer record;
/// PLATFORM_ADMIN users have tenantId = null.
model User {
  id           String    @id @default(cuid())
  tenantId     String?
  // Not globally @unique: a CUSTOMER may hold independent portal accounts
  // at more than one tenant with the same email address (Stage 2C). Unique
  // only per tenant instead — see @@unique below. Accepted trade-off:
  // PLATFORM_ADMIN rows have tenantId = null, and Postgres treats each NULL
  // as distinct for uniqueness, so two platform admins could theoretically
  // share an email post-change. Acceptable since platform admins are only
  // ever created manually/via seed, never self-serve.
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  /// Set on every successful password change/reset (self-service change,
  /// or the forgot-password flow) — never on account creation itself, so
  /// existing seeded/production accounts start with this null. JwtStrategy
  /// rejects any JWT whose `iat` predates this timestamp, which is what
  /// actually invalidates already-issued sessions/tokens after a reset;
  /// see JwtStrategy's own doc comment. A null value here means "never
  /// reset" and is never treated as later than any token's `iat`.
  passwordChangedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation("CustomerUser")

  notifications                 Notification[]
  itemsReceived                 ShipmentItem[] // items this user marked received (ShipmentItem.receivedByUserId)
  itemsLastInspected            ShipmentItem[]         @relation("ShipmentItemLastInspectedBy") // items this user most recently inspected (denormalized convenience only — see ItemInspection for history)
  itemInspections               ItemInspection[] // full inspection history this user performed
  pickupDeliveryRecordsHandled  PickupDeliveryRecord[] @relation("PickupDeliveryHandledBy") // handoffs this user personally performed
  pickupDeliveryRecordsAsDriver PickupDeliveryRecord[] @relation("PickupDeliveryDriver") // deliveries this user drove/couriered (unused until Delivery milestone)
  trackingEventsCreated         TrackingEvent[] // audit trail rows this user is the actor for
  containerItemsLoaded          ContainerItem[]        @relation("ContainerItemLoadedBy")
  containerItemsRemoved         ContainerItem[]        @relation("ContainerItemRemovedBy")
  containersFinalized           Container[]
  manifestsFinalized            Manifest[]             @relation("ManifestFinalizedBy")
  manifestsDeparted             Manifest[]             @relation("ManifestDepartedBy")
  manifestsArrived              Manifest[]             @relation("ManifestArrivedBy")
  manifestItemsAdded            ManifestItem[]         @relation("ManifestItemAddedBy")
  manifestItemsRemoved          ManifestItem[]         @relation("ManifestItemRemovedBy")
  documentsUploaded             Document[]             @relation("DocumentUploader") // Stage 3G
  operationalExceptionsCreated  OperationalException[] // Stage 3H
  notificationEventsTriggered   NotificationEvent[] // Stage 3H
  tenantInvitationsSent         TenantInvitation[]
  platformAuditLogsPerformed    PlatformAuditLog[]
  accountTokens                 AccountToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Password-recovery/account-lifecycle purpose an AccountToken was issued
/// for. INVITE_ACTIVATION is not yet issued by any code path (staff/
/// customer invite-acceptance is a later stage) but is included now so
/// that work doesn't need a second migration to reuse this same table.
enum AccountTokenPurpose {
  PASSWORD_RESET
  INVITE_ACTIVATION
}

/// A single-use, expiring token proving possession of a specific User's
/// email — the forgot-password flow's only source of truth for "is this
/// reset request legitimate." Deliberately holds only `tokenHash` (SHA-256
/// of the raw token emailed to the user), never the raw token itself, so a
/// database read/leak alone can never be used to reset an account —
/// exactly the same reasoning `User.passwordHash` already applies to
/// passwords. `userId` (not a bare email) is what ties this to tenant/role
/// context: resolving straight to a specific User row means every
/// existing tenant-isolation and role check downstream needs zero changes
/// to account for this table.
model AccountToken {
  id        String              @id @default(cuid())
  userId    String
  purpose   AccountTokenPurpose
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("account_tokens")
}

/// A customer (shipper) belonging to a tenant. May optionally have a
/// linked User account for portal access.
model Customer {
  id               String   @id @default(cuid())
  tenantId         String
  customerNumber   String
  firstName        String
  lastName         String
  email            String
  phone            String?
  userId           String?  @unique
  /// Stage 3H: per-channel notification opt-in. Email defaults on (matches
  /// how every business in this domain already communicates); SMS and
  /// WhatsApp default OFF — both are opt-in by design (WhatsApp Business
  /// Platform policy requires demonstrable opt-in for business-initiated
  /// messages outside a customer-started session; SMS carries a real cost
  /// per message and the same "ask, don't assume" posture applies).
  notifyByEmail    Boolean  @default(true)
  notifyBySms      Boolean  @default(false)
  notifyByWhatsapp Boolean  @default(false)
  /// E.164-formatted (e.g. "+233201234567") — deliberately separate from
  /// the general `phone` field above, since a WhatsApp send target must be
  /// the specific number the customer opted in with, not just "whatever
  /// phone number happens to be on file."
  whatsappPhone    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?          @relation("CustomerUser", fields: [userId], references: [id], onDelete: SetNull)
  addresses     Address[]
  shipments     Shipment[]
  quotes        Quote[]
  invoices      Invoice[]
  payments      Payment[]
  documents     Document[]
  notifications Notification[]

  @@unique([tenantId, customerNumber])
  @@index([tenantId])
  /// Stage 4: customer-growth-over-time analytics group by tenantId+createdAt.
  @@index([tenantId, createdAt])
  @@map("customers")
}

/// Billing / shipping / destination addresses for a customer.
model Address {
  id         String      @id @default(cuid())
  tenantId   String
  customerId String
  type       AddressType @default(SHIPPING)
  label      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String
  phone      String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("addresses")
}

// ==========================================================================
// WAREHOUSE / ROUTES
// ==========================================================================

/// A tenant may operate multiple warehouses (e.g. an origin warehouse in
/// Texas and destination warehouses in Accra/Tema). Nothing here assumes
/// a specific tenant's locations.
model Warehouse {
  id                     String   @id @default(cuid())
  tenantId               String
  name                   String
  code                   String
  addressLine1           String
  addressLine2           String?
  city                   String
  state                  String?
  country                String
  postalCode             String?
  phone                  String?
  isOriginWarehouse      Boolean  @default(false)
  isDestinationWarehouse Boolean  @default(false)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originRoutes         Route[]    @relation("RouteOriginWarehouse")
  destinationRoutes    Route[]    @relation("RouteDestinationWarehouse")
  originShipments      Shipment[] @relation("ShipmentOriginWarehouse")
  destinationShipments Shipment[] @relation("ShipmentDestinationWarehouse")

  /// Items currently physically located here (ShipmentItem.currentWarehouseId).
  /// Updated as items move through receiving, processing, and destination
  /// handoff — this is a live "where is it right now" pointer, not history;
  /// TrackingEvent.warehouseId is the historical record.
  currentItems          ShipmentItem[]
  trackingEvents        TrackingEvent[]
  itemInspections       ItemInspection[]
  pickupDeliveryRecords PickupDeliveryRecord[]
  /// Containers currently being loaded at this warehouse (Milestone 3D).
  containers            Container[]
  /// Manifests originating from this warehouse (Milestone 3E).
  manifests             Manifest[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

/// An optional named lane between two warehouses/countries, used later to
/// drive quoting and transit-time estimates.
model Route {
  id                     String       @id @default(cuid())
  tenantId               String
  name                   String
  originWarehouseId      String?
  destinationWarehouseId String?
  originCountry          String
  destinationCountry     String
  shipmentMode           ShipmentMode
  transitDaysEstimate    Int?
  isActive               Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originWarehouse      Warehouse?  @relation("RouteOriginWarehouse", fields: [originWarehouseId], references: [id], onDelete: SetNull)
  destinationWarehouse Warehouse?  @relation("RouteDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  shipments            Shipment[]
  /// Containers declared to be traveling this route (Milestone 3D) — used
  /// only for a soft destination-compatibility check when loading items.
  containers           Container[]
  /// Manifests declared to be traveling this route (Milestone 3E) — same
  /// soft-check purpose as Container.route above.
  manifests            Manifest[]

  @@index([tenantId])
  @@map("routes")
}

// ==========================================================================
// SHIPMENTS
// ==========================================================================

/// A single shipment for a customer. `trackingNumber` is the public,
/// human-friendly identifier — the database id is never exposed to
/// customers. A shipment is a customer-facing grouping; see ShipmentItem
/// for the independently scannable physical pieces inside it.
///
/// MULTI-TENANT SAAS: `trackingNumber` is unique per tenant, not globally.
/// Two independent logistics companies on this platform may each issue
/// "TAL-2026-000001" (or, more realistically, collide on the same
/// prefix/sequence combination) without conflicting — every lookup is
/// already scoped by tenantId at the application layer (see
/// ShipmentsService, WarehouseService), so this only relaxes a DB
/// constraint that was stricter than the access pattern requires.
model Shipment {
  id                     String         @id @default(cuid())
  tenantId               String
  customerId             String
  trackingNumber         String
  shipmentMode           ShipmentMode
  originCountry          String
  destinationCountry     String
  originLocation         String?
  destinationLocation    String?
  originWarehouseId      String?
  destinationWarehouseId String?
  routeId                String?
  status                 ShipmentStatus @default(DRAFT)
  description            String?
  declaredValue          Decimal?       @db.Decimal(12, 2)
  currency               String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  originWarehouse       Warehouse?             @relation("ShipmentOriginWarehouse", fields: [originWarehouseId], references: [id], onDelete: SetNull)
  destinationWarehouse  Warehouse?             @relation("ShipmentDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  route                 Route?                 @relation(fields: [routeId], references: [id], onDelete: SetNull)
  items                 ShipmentItem[]
  trackingEvents        TrackingEvent[]
  itemInspections       ItemInspection[]
  pickupDeliveryRecords PickupDeliveryRecord[]
  /// Item-level container assignments for this shipment's items. A single
  /// shipment's items are not guaranteed to all be in the same container.
  containerItems        ContainerItem[]
  /// Item-level direct manifest assignments (air-freight path, Milestone 3E).
  manifestItems         ManifestItem[]
  quotes                Quote[]
  invoices              Invoice[]
  documents             Document[]
  notificationEvents    NotificationEvent[]

  @@unique([tenantId, trackingNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  /// Stage 4: shipment-volume-trend analytics group by tenantId+createdAt.
  @@index([tenantId, createdAt])
  @@map("shipments")
}

/// A physical package/item within a shipment (box, barrel, vehicle, ...).
/// This is the unit of barcode/QR scanning: every ShipmentItem gets a
/// unique, short, human-readable `itemCode` that is what actually gets
/// printed on a label and scanned at each workflow step. Dimensions are
/// optional but present to support future dimensional/volumetric weight
/// pricing.
model ShipmentItem {
  id         String @id @default(cuid())
  tenantId   String
  shipmentId String

  /// Scan payload. Derived from the parent shipment's trackingNumber plus
  /// this item's sequenceNumber (e.g. "TAL-2026-000001-02"), so it is
  /// unique per tenant the same way trackingNumber is (see the
  /// MULTI-TENANT SAAS note on Shipment.trackingNumber above — every scan
  /// lookup is already tenantId-scoped at the application layer), and
  /// remains short enough to hand-key if a scanner fails.
  itemCode       String
  /// 1-based position of this item within its shipment (item 2 of 4).
  sequenceNumber Int

  itemType      ShipmentItemType
  /// Denormalized current workflow state; TrackingEvent rows (filtered by
  /// shipmentItemId) are the authoritative history behind this value.
  status        ShipmentItemStatus     @default(REGISTERED)
  description   String?
  quantity      Int                    @default(1)
  length        Decimal?               @db.Decimal(10, 2)
  width         Decimal?               @db.Decimal(10, 2)
  height        Decimal?               @db.Decimal(10, 2)
  dimensionUnit DimensionUnit          @default(IN)
  weight        Decimal?               @db.Decimal(10, 2)
  weightUnit    WeightUnit             @default(LB)
  declaredValue Decimal?               @db.Decimal(12, 2)
  /// Controlled-vocabulary physical condition, denormalized from the most
  /// recent ItemInspection row the same way `status` is denormalized from
  /// TrackingEvent — null until the item has been inspected at least once.
  /// See Milestone 3C: ItemInspection is the append-only history behind
  /// this "current known condition" convenience field.
  condition     ShipmentItemCondition?

  /// Reference-only external carrier tracking info (UPS/FedEx/USPS/Amazon
  /// inbound leg, etc.). Never used as an internal lookup key — itemCode
  /// and trackingNumber remain authoritative inside this system.
  externalTrackingCarrier String?
  externalTrackingNumber  String?

  /// Live "where is this item right now" pointer, updated on each
  /// location-changing scan. Nullable because an item may not yet have
  /// touched a warehouse (still REGISTERED).
  currentWarehouseId String?
  receivedAt         DateTime?
  receivedByUserId   String?

  /// Denormalized "current summary" convenience fields only — same
  /// relationship receivedAt/receivedByUserId have to the receiving
  /// TrackingEvent. ItemInspection is the authoritative, append-only
  /// history; these two columns just avoid a join for "who/when was this
  /// last looked at" reads and are overwritten on every (re)inspection.
  lastInspectedAt       DateTime?
  lastInspectedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment              Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  vehicleDetails        VehicleDetails?
  currentWarehouse      Warehouse?             @relation(fields: [currentWarehouseId], references: [id], onDelete: SetNull)
  receivedByUser        User?                  @relation(fields: [receivedByUserId], references: [id], onDelete: SetNull)
  lastInspectedByUser   User?                  @relation("ShipmentItemLastInspectedBy", fields: [lastInspectedByUserId], references: [id], onDelete: SetNull)
  trackingEvents        TrackingEvent[]
  containerItems        ContainerItem[]
  manifestItems         ManifestItem[]
  /// Full append-only inspection history (Milestone 3C). Ordered by
  /// inspectedAt for "most recent" reads; never updated or deleted, so
  /// reinspection always adds a new row instead of overwriting one.
  inspections           ItemInspection[]
  /// Full pickup/delivery handoff history (Customer Pickup milestone).
  /// Ordered by handledAt for "most recent" reads; never updated or
  /// deleted — same append-only posture as `inspections` above.
  pickupDeliveryRecords PickupDeliveryRecord[]

  @@unique([shipmentId, sequenceNumber])
  @@unique([tenantId, itemCode])
  @@index([tenantId])
  @@index([shipmentId])
  @@index([status])
  @@index([currentWarehouseId])
  @@map("shipment_items")
}

/// One warehouse inspection/processing event for a single ShipmentItem
/// (Milestone 3C). Append-only, like TrackingEvent — a reinspection
/// creates a new row rather than editing a prior one, so the full history
/// of what was observed and decided is always reconstructable. The
/// `trackingEventId` links each inspection to the TrackingEvent it
/// produced (PROCESSED or EXCEPTION), keeping the audit trail's single
/// timeline in sync with this table's richer structured detail.
///
/// `condition`/`result` here are the point-in-time record; ShipmentItem's
/// `condition`/`lastInspectedAt`/`lastInspectedByUserId` are only a
/// denormalized "most recent" convenience read of this table — never the
/// other way around. `result` never gets its own denormalized copy on
/// ShipmentItem: ShipmentItemStatus (PROCESSED vs EXCEPTION) is already
/// the single authoritative "is this item eligible to move forward"
/// signal, so a future container-loading check only ever needs to read
/// one column, never combine this table with ShipmentItem.status.
///
/// Photos/damage documentation are intentionally not modeled yet —
/// Document already has a `PHOTO` DocumentType but no ShipmentItem/
/// inspection FK. Adding a nullable `shipmentItemId` (or
/// `itemInspectionId`) to Document later is a small, additive migration,
/// not a redesign of this table.
model ItemInspection {
  id             String @id @default(cuid())
  tenantId       String
  shipmentId     String
  shipmentItemId String
  warehouseId    String

  /// Actual measurements captured during this inspection. Distinct from
  /// (and, on success, copied forward into) ShipmentItem's own
  /// length/width/height/weight columns, which this inspection makes
  /// authoritative going forward — see WarehouseService.processItem.
  weight        Decimal?       @db.Decimal(10, 2)
  weightUnit    WeightUnit?
  length        Decimal?       @db.Decimal(10, 2)
  width         Decimal?       @db.Decimal(10, 2)
  height        Decimal?       @db.Decimal(10, 2)
  dimensionUnit DimensionUnit?

  condition            ShipmentItemCondition
  result               ItemProcessingResult
  hasException         Boolean               @default(false)
  exceptionDescription String?
  notes                String?

  inspectedByUserId String?
  inspectedAt       DateTime @default(now())
  trackingEventId   String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentItem    ShipmentItem   @relation(fields: [shipmentItemId], references: [id], onDelete: Cascade)
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inspectedByUser User?          @relation(fields: [inspectedByUserId], references: [id], onDelete: SetNull)
  trackingEvent   TrackingEvent? @relation(fields: [trackingEventId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([shipmentId])
  @@index([shipmentItemId])
  @@index([warehouseId])
  @@map("item_inspections")
}

/// One structured delivery-lifecycle event for a single ShipmentItem:
/// Customer Pickup (final handoff), or, for courier delivery, DISPATCH
/// (item leaves the warehouse) followed later by its own separate
/// DELIVERY row (final handoff) or a RETURNED_TO_WAREHOUSE TrackingEvent
/// (see WarehouseService.returnItem — a failed/retried attempt does not
/// get its own PickupDeliveryRecord, only DISPATCH and terminal outcomes
/// do). Append-only and immutable like ItemInspection: a correction is a
/// new row, never an edit to an existing one — a DISPATCH row is never
/// later rewritten into a DELIVERY row, so the original dispatch details
/// survive even across multiple failed/retried attempts, and the handoff
/// record a recipient signed for/was verified against can never be
/// silently changed after the fact.
///
/// Deliberately does not yet have signature/photo columns. The plan (see
/// the Document model's own comment) is a later, additive
/// `Document.shipmentItemId` (or `pickupDeliveryRecordId`) FK — adding
/// that is a small migration, not a redesign of this table or the
/// pickup/delivery workflow built on top of it.
model PickupDeliveryRecord {
  id             String @id @default(cuid())
  tenantId       String
  shipmentId     String
  shipmentItemId String
  /// The destination warehouse this handoff physically happened at —
  /// same "must match the item's currentWarehouseId" invariant
  /// WarehouseService.destinationReceiveItem already enforces for
  /// receiving, enforced here in the pickup/delivery service.
  warehouseId    String

  type HandoffType

  recipientName        String
  recipientPhone       String?
  recipientIdReference String?
  notes                String?

  /// Point-in-time delivery-address snapshot, captured at DISPATCH —
  /// same "free-text snapshot, not a live FK" rationale as
  /// Shipment.originLocation/destinationLocation: an address the
  /// customer changes later must never rewrite this record. Null for
  /// PICKUP (no delivery address involved) and typically left unset on
  /// the later DELIVERY confirmation row (implied unchanged from dispatch
  /// unless the attempt failed, which is its own RETURNED_TO_WAREHOUSE
  /// event, not a successful DELIVERY row).
  deliveryAddress String?

  /// Driver/courier identity. Two independent ways to record it, not a
  /// single required field — this tenant may staff deliveries with a
  /// logged-in employee (driverUserId), or with an independent driver /
  /// third-party courier company that has no application account at all
  /// (courierName/courierPhone/courierReference, free text). Service-layer
  /// validation (not a DB constraint) requires at least one to be present
  /// on a DISPATCH or DELIVERY record; both are always null on PICKUP.
  driverUserId     String?
  courierName      String?
  courierPhone     String?
  /// Free-text vehicle/company/tracking reference — e.g. plate number,
  /// "DHL Ghana", a third-party waybill number. Optional, never validated.
  courierReference String?

  handledByUserId String?
  handledAt       DateTime @default(now())
  /// Links to the TrackingEvent this record produced — same
  /// one-to-one pattern ItemInspection.trackingEventId already uses,
  /// keeping the audit trail's single timeline in sync with this table's
  /// richer structured detail.
  trackingEventId String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment      Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentItem  ShipmentItem   @relation(fields: [shipmentItemId], references: [id], onDelete: Cascade)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  handledByUser User?          @relation("PickupDeliveryHandledBy", fields: [handledByUserId], references: [id], onDelete: SetNull)
  driverUser    User?          @relation("PickupDeliveryDriver", fields: [driverUserId], references: [id], onDelete: SetNull)
  trackingEvent TrackingEvent? @relation(fields: [trackingEventId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([shipmentId])
  @@index([shipmentItemId])
  @@index([warehouseId])
  @@map("pickup_delivery_records")
}

/// Extra detail attached to a ShipmentItem of type VEHICLE. Modeled as a
/// 1:1 extension of ShipmentItem rather than a parallel shipping system.
model VehicleDetails {
  id             String             @id @default(cuid())
  tenantId       String
  shipmentItemId String             @unique
  vin            String?
  year           Int?
  make           String?
  model          String?
  color          String?
  titleStatus    VehicleTitleStatus @default(UNKNOWN)
  licensePlate   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipmentItem ShipmentItem @relation(fields: [shipmentItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("vehicle_details")
}

// ==========================================================================
// CONTAINERS / MANIFESTS
// ==========================================================================

/// A shipping container, which may carry items belonging to many
/// different customers/shipments (linked via ContainerItem).
///
/// MILESTONE 3D (Load Container/Consolidation): `warehouseId` is the
/// physical location a container is being loaded at — every item scanned
/// into this container must currently be at that same warehouse (see
/// ContainersService.loadItem). `routeId` is optional and only used for a
/// soft destination-compatibility check, not a hard constraint — this
/// schema doesn't have structured port/country data precise enough to
/// safely hard-block on. `loadingFinalizedAt`/`loadingFinalizedByUserId`
/// mirror Manifest.finalizedAt/finalizedByUserId: once set, the
/// container's ContainerItem rows are immutable (no more load/unload).
model Container {
  id                       String          @id @default(cuid())
  tenantId                 String
  containerNumber          String
  containerType            ContainerType
  sealNumber               String?
  status                   ContainerStatus @default(BOOKED)
  warehouseId              String?
  routeId                  String?
  /// Milestone 3E: the manifest (transport movement) this LOADED
  /// container is scheduled on — null until assigned. A container can be
  /// on at most one manifest at a time (assignment itself, and the
  /// eligibility rules around it, are a later controlled step; this
  /// column is schema-only for now).
  manifestId               String?
  originPort               String?
  destinationPort          String?
  departureDate            DateTime?
  estimatedArrival         DateTime?
  actualArrival            DateTime?
  loadingFinalizedAt       DateTime?
  loadingFinalizedByUserId String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse              Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  route                  Route?                 @relation(fields: [routeId], references: [id], onDelete: SetNull)
  manifest               Manifest?              @relation(fields: [manifestId], references: [id], onDelete: SetNull)
  loadingFinalizedByUser User?                  @relation(fields: [loadingFinalizedByUserId], references: [id], onDelete: SetNull)
  items                  ContainerItem[]
  operationalExceptions  OperationalException[]

  @@unique([tenantId, containerNumber])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([manifestId])
  @@map("containers")
}

/// Item-level container loading — the source of truth for what is
/// physically inside a container. Deliberately item-granular (not
/// shipment-granular): a shipment's items are not required to all travel
/// in the same container, and this table is what lets staff answer
/// "how many of this shipment's items are actually loaded" precisely.
///
/// A row is never deleted when an item is taken back out of a container —
/// it is marked removed (removedAt/removedByUserId/removalReason) so the
/// load history stays auditable instead of silently disappearing.
/// "Currently loaded" = removedAt IS NULL. Preventing duplicate *active*
/// loads is enforced at the application layer (Milestone 3E), not a DB
/// constraint here, because a legitimate item history can include more
/// than one load/remove cycle over time.
model ContainerItem {
  id             String @id @default(cuid())
  tenantId       String
  containerId    String
  /// Denormalized alongside shipmentItemId so manifest generation can
  /// group/join by shipment without an extra hop through ShipmentItem.
  shipmentId     String
  shipmentItemId String

  loadedAt        DateTime  @default(now())
  loadedByUserId  String?
  removedAt       DateTime?
  removedByUserId String?
  removalReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  container     Container    @relation(fields: [containerId], references: [id], onDelete: Cascade)
  shipment      Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentItem  ShipmentItem @relation(fields: [shipmentItemId], references: [id], onDelete: Cascade)
  loadedByUser  User?        @relation("ContainerItemLoadedBy", fields: [loadedByUserId], references: [id], onDelete: SetNull)
  removedByUser User?        @relation("ContainerItemRemovedBy", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([containerId])
  @@index([shipmentId])
  @@index([shipmentItemId])
  @@map("container_items")
}

/// A manifest represents one transport movement (one vessel voyage or one
/// flight) — the generalization Milestone 3E needed so air freight is
/// never forced through the ocean-container concept. A manifest carries
/// cargo via two independent, mode-exclusive paths:
///   - Ocean/RoRo: one or more already-sealed (LOADED) Containers, linked
///     from Container.manifestId (see Container). A manifest never
///     touches those containers' ShipmentItems directly.
///   - Air: ShipmentItems assigned straight to the manifest with no
///     container in between, via ManifestItem below.
/// `shipmentMode` determines which path is valid for a given manifest —
/// enforced at the application layer once assignment is implemented, not
/// by a DB constraint (Prisma has no cross-table CHECK support here).
///
/// Contents are always derivable live from Container.manifestId +
/// ManifestItem rather than hand-maintained. `snapshotJson` freezes that
/// derived view at finalize time, the same relationship
/// Container.loadingFinalizedAt has to ContainerItem.
///
/// MILESTONE 3E-A SCOPE: this migration adds the full data model and the
/// create/list/detail backend. Assigning containers/items, finalizing,
/// and recording departure (and the resulting status roll-forward) are
/// deliberately separate, later controlled steps — `finalizedAt`/
/// `finalizedByUserId`/`departedAt`/`departedByUserId`/`snapshotJson`
/// all exist now but are only ever written by that later work.
model Manifest {
  id             String         @id @default(cuid())
  tenantId       String
  manifestNumber String
  status         ManifestStatus @default(DRAFT)
  shipmentMode   ShipmentMode

  /// The warehouse this movement originates from. Used (once assignment
  /// is implemented) to validate that every container/item assigned to
  /// this manifest is physically at the same location.
  originWarehouseId   String?
  routeId             String?
  originLocation      String?
  destinationLocation String?

  /// Shipping line or airline — one generic field for both modes.
  carrierName  String?
  /// Ocean only.
  vesselName   String?
  voyageNumber String?
  /// Air only.
  flightNumber String?

  plannedDepartureAt DateTime?
  estimatedArrivalAt DateTime?

  finalizedAt       DateTime?
  finalizedByUserId String?
  departedAt        DateTime?
  departedByUserId  String?
  /// Milestone 3F: when this movement's cargo landed at destination.
  /// Setting this cascades every affected container to ARRIVED and every
  /// affected item to ARRIVED_DESTINATION — it does not itself mean any
  /// individual item has been physically received at a destination
  /// warehouse (that is a separate, later, per-item action).
  arrivedAt         DateTime?
  arrivedByUserId   String?

  /// Immutable snapshot of derived contents (containers + direct items)
  /// at finalize time.
  snapshotJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originWarehouse       Warehouse?             @relation(fields: [originWarehouseId], references: [id], onDelete: SetNull)
  route                 Route?                 @relation(fields: [routeId], references: [id], onDelete: SetNull)
  finalizedByUser       User?                  @relation("ManifestFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  departedByUser        User?                  @relation("ManifestDepartedBy", fields: [departedByUserId], references: [id], onDelete: SetNull)
  arrivedByUser         User?                  @relation("ManifestArrivedBy", fields: [arrivedByUserId], references: [id], onDelete: SetNull)
  /// Sealed/loaded containers scheduled on this manifest (ocean/RoRo path).
  containers            Container[]
  /// Items assigned directly to this manifest with no container (air path).
  items                 ManifestItem[]
  operationalExceptions OperationalException[]

  @@unique([tenantId, manifestNumber])
  @@index([tenantId])
  @@index([originWarehouseId])
  @@map("manifests")
}

/// Direct item-to-manifest assignment for the air-freight path — the
/// structural equivalent of ContainerItem, minus any container. Same
/// soft-remove audit pattern: a row is never deleted when an item is
/// unassigned, only marked removed, so the assignment history stays
/// auditable. "Currently assigned" = removedAt IS NULL.
///
/// MILESTONE 3E-A SCOPE: this table exists now so the schema is complete;
/// nothing writes to it yet — assignment is a later controlled step.
model ManifestItem {
  id             String @id @default(cuid())
  tenantId       String
  manifestId     String
  /// Denormalized alongside shipmentItemId, same reasoning as
  /// ContainerItem.shipmentId — lets reporting group/join by shipment
  /// without an extra hop through ShipmentItem.
  shipmentId     String
  shipmentItemId String

  addedAt         DateTime  @default(now())
  addedByUserId   String?
  removedAt       DateTime?
  removedByUserId String?
  removalReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manifest      Manifest     @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  shipment      Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentItem  ShipmentItem @relation(fields: [shipmentItemId], references: [id], onDelete: Cascade)
  addedByUser   User?        @relation("ManifestItemAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)
  removedByUser User?        @relation("ManifestItemRemovedBy", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([manifestId])
  @@index([shipmentId])
  @@index([shipmentItemId])
  @@map("manifest_items")
}

// ==========================================================================
// TRACKING
// ==========================================================================

/// Append-only audit trail — the source of truth for everything that has
/// ever happened to a shipment or one of its items. Never updated or
/// deleted, only inserted into. Shipment.status and ShipmentItem.status
/// are denormalized "current state" reads derived from this history.
///
/// `shipmentItemId` is null for shipment-level events (e.g. SHIPMENT_CREATED)
/// and set for item-level events (e.g. a specific box being scanned in).
/// `status` optionally snapshots what Shipment.status was set to as a
/// result of this event, for shipment-level status-changing events — it is
/// null for purely operational/item-level events that don't move the
/// shipment's overall status (e.g. MEASURED, ASSIGNED_TO_CONTAINER).
model TrackingEvent {
  id             String  @id @default(cuid())
  tenantId       String
  shipmentId     String
  shipmentItemId String?

  eventType TrackingEventType
  /// How this event was captured (scan vs. manual vs. system-generated).
  source    TrackingEventSource @default(MANUAL)
  /// Shipment-level status this event resulted in, when applicable.
  status    ShipmentStatus?

  warehouseId    String?
  location       String?
  notes          String?
  /// Raw scanned code/payload, when source is a scan — kept for audit and
  /// for debugging "why did this scan resolve to the wrong item" reports.
  scanIdentifier String?
  /// Flexible bag for event-specific structured data (measured dimensions,
  /// exception reason codes, etc.) without a new column per event type.
  metadata       Json?

  occurredAt      DateTime @default(now())
  createdByUserId String?
  createdAt       DateTime @default(now())

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment             Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentItem         ShipmentItem?         @relation(fields: [shipmentItemId], references: [id], onDelete: Cascade)
  warehouse            Warehouse?            @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdByUser        User?                 @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// The ItemInspection this event was produced by, when eventType is
  /// PROCESSED or EXCEPTION as a result of Milestone 3C processing —
  /// null for every other event type.
  itemInspection       ItemInspection?
  /// The PickupDeliveryRecord this event was produced by, when eventType
  /// is PICKED_UP (or, later, DELIVERED) — null for every other event type.
  pickupDeliveryRecord PickupDeliveryRecord?

  @@index([tenantId])
  @@index([shipmentId])
  @@index([shipmentItemId])
  @@index([warehouseId])
  @@index([eventType])
  @@map("tracking_events")
}

// ==========================================================================
// COMMERCIAL: QUOTES / INVOICES / PAYMENTS
// ==========================================================================

model Quote {
  id                 String       @id @default(cuid())
  tenantId           String
  customerId         String
  shipmentId         String?
  shipmentMode       ShipmentMode
  originCountry      String
  destinationCountry String
  estimatedCost      Decimal?     @db.Decimal(12, 2)
  currency           String?
  status             QuoteStatus  @default(DRAFT)
  validUntil         DateTime?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@map("quotes")
}

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String
  shipmentId    String?
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  currency      String
  dueDate       DateTime?
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shipment           Shipment?           @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  items              InvoiceItem[]
  payments           Payment[]
  notificationEvents NotificationEvent[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([customerId])
  /// Stage 4: outstanding/aging analytics filter by tenantId+status (never
  /// InvoiceStatus.OVERDUE, which nothing in this codebase ever sets — see
  /// AnalyticsService's own doc comment — but SENT/PARTIALLY_PAID lookups
  /// still benefit).
  @@index([tenantId, status])
  /// Stage 4: aging-bucket analytics filter/sort by tenantId+dueDate.
  @@index([tenantId, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                String        @id @default(cuid())
  tenantId          String
  invoiceId         String
  customerId        String
  amount            Decimal       @db.Decimal(12, 2)
  currency          String
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  /// Stage 3F: MANUAL (staff-recorded, Stage 3B) or ONLINE (customer self-service via a payment provider). Defaults to MANUAL so every pre-Stage-3F payment row is correctly classified without a backfill. This is the only field that disambiguates the two flows — `method` alone can't, since CARD is a legitimate value for both (a staff member manually logging a card payment taken over the phone vs. Stripe Checkout).
  source            PaymentSource @default(MANUAL)
  /// Stage 3F: the payment provider that processed an ONLINE payment, e.g. "STRIPE". Always null for MANUAL payments.
  provider          String?
  /// Stage 3F: the provider's own identifier for this payment (Stripe Checkout Session id) — never a secret, just a reconciliation handle. @unique doubles as the idempotency key a webhook lookup uses: at most one Payment row can ever exist per provider session, so a redelivered webhook event finds the same row instead of creating a duplicate.
  providerReference String?       @unique
  referenceNumber   String?
  /// Stage 3B: optional staff-entered note on a manually-recorded payment (e.g. "confirmed via bank statement"). Never edited after creation — payments are append-only, like TrackingEvent.
  notes             String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice            Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  notificationEvents NotificationEvent[]

  @@index([tenantId])
  @@index([invoiceId])
  /// Stage 4: revenue-collected analytics filter by tenantId+status
  /// (COMPLETED only) and group/sort by paidAt for trend charts.
  @@index([tenantId, status, paidAt])
  /// Stage 4: top-customers-by-revenue analytics group by tenantId+customerId.
  @@index([tenantId, customerId])
  @@map("payments")
}

// ==========================================================================
// DOCUMENTS / NOTIFICATIONS
// ==========================================================================

/// Stage 3G: `fileUrl` holds an opaque storage key (e.g. "tenantId/uuid-name.pdf"),
/// never a directly-reachable URL — StorageProvider is the only thing that
/// knows how to resolve a key back to actual bytes, and the API never
/// serializes this column to any client response (see DocumentsService's
/// toSummary/toPortalSummary). Downloads always go through
/// GET /documents/:id/download or GET /portal/invoices/:id/download,
/// which check ownership first.
model Document {
  id                String       @id @default(cuid())
  tenantId          String
  customerId        String?
  shipmentId        String?
  type              DocumentType
  fileName          String
  fileUrl           String
  mimeType          String?
  fileSizeBytes     Int?
  /// Optional staff-entered context, e.g. "BOL — Container ABC123".
  description       String?
  /// Stage 3G: fail-closed — a document is staff-only until a staff member
  /// explicitly marks it customer-visible. Mirrors the same
  /// explicit-opt-in philosophy already used for DRAFT invoices and the
  /// @Public()/@Roles() route guards.
  visibleToCustomer Boolean      @default(false)
  uploadedByUserId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shipment           Shipment?           @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  uploadedByUser     User?               @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  notificationEvents NotificationEvent[]

  @@index([tenantId])
  @@index([shipmentId])
  @@index([customerId])
  @@map("documents")
}

/// Stage 3H: a staff-reported operational disruption on a container or
/// manifest (delayed/held/inspected/impounded/other) — the anchor record
/// for the bulk customer-notification flow. `message` is the staff-written,
/// customer-safe explanation that gets sent verbatim to every affected
/// customer; exactly one of containerId/manifestId is ever set.
model OperationalException {
  id              String         @id @default(cuid())
  tenantId        String
  containerId     String?
  manifestId      String?
  type            DisruptionType
  message         String
  createdByUserId String?
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  container          Container?          @relation(fields: [containerId], references: [id], onDelete: Cascade)
  manifest           Manifest?           @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  createdByUser      User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  notificationEvents NotificationEvent[]

  @@index([tenantId])
  @@index([containerId])
  @@index([manifestId])
  /// Stage 4: exceptions-by-period / open-vs-resolved analytics group by
  /// tenantId+createdAt.
  @@index([tenantId, createdAt])
  @@map("operational_exceptions")
}

/// Stage 3H: one row per distinct business occurrence that was evaluated
/// for notification-worthiness — the "did this happen yet" record.
/// `dedupeKey` (unique per tenant) is what stops the same underlying
/// occurrence (e.g. a status correction re-recording the same status)
/// from firing customer notifications twice; see NotificationsService.
/// Exactly one of shipmentId/documentId/invoiceId/paymentId/
/// operationalExceptionId is set, matching `eventType`. Deliberately NOT
/// per-recipient — a single event fans out into N Notification rows (one
/// per affected customer per enabled channel), all linked back here via
/// Notification.eventId.
model NotificationEvent {
  id                     String                @id @default(cuid())
  tenantId               String
  eventType              NotificationEventType
  shipmentId             String?
  documentId             String?
  invoiceId              String?
  paymentId              String?
  operationalExceptionId String?
  dedupeKey              String?
  /// Internal/staff-facing summary, e.g. "TAL-2026-000001 reached READY_FOR_PICKUP" — never shown to a customer directly (each Notification row has its own customer-safe title/body).
  title                  String
  /// Null for system-derived events (status rollups, payment recorded);
  /// set to the acting staff member for STAFF_ANNOUNCEMENT/CONTAINER_DISRUPTED.
  triggeredByUserId      String?
  createdAt              DateTime              @default(now())

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment             Shipment?             @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  document             Document?             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  invoice              Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment              Payment?              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  operationalException OperationalException? @relation(fields: [operationalExceptionId], references: [id], onDelete: Cascade)
  triggeredByUser      User?                 @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  notifications        Notification[]

  @@unique([tenantId, dedupeKey])
  @@index([tenantId])
  @@map("notification_events")
}

model Notification {
  id                String              @id @default(cuid())
  tenantId          String
  eventId           String?
  userId            String?
  customerId        String?
  channel           NotificationChannel @default(IN_APP)
  status            NotificationStatus  @default(PENDING)
  title             String
  body              String
  /// Stage 3H: the outbound provider's own message id (email provider
  /// message id, Twilio SID, WhatsApp message id) — set once actually
  /// dispatched; always null for IN_APP (nothing to dispatch) and for a
  /// console/no-op provider result.
  providerMessageId String?
  /// Stage 3H: populated when status is FAILED — why the send failed.
  errorMessage      String?
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  event    NotificationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@index([eventId])
  @@map("notifications")
}

// ==========================================================================
// WEBSITE LAUNCH: PUBLIC LEAD CAPTURE
// ==========================================================================

/// Website Launch: a public, unauthenticated lead captured from the
/// marketing site's Contact or Request-a-Quote forms — deliberately NOT
/// the same thing as Quote (which requires an existing Customer record).
/// A visitor filling out either form isn't a customer yet; staff review
/// leads here and manually create a real Customer/Quote through the
/// existing flows if/when one converts — this table never auto-creates
/// either, and carries no FK to them.
model WebsiteLead {
  id       String            @id @default(cuid())
  tenantId String
  type     WebsiteLeadType
  status   WebsiteLeadStatus @default(NEW)

  firstName String
  lastName  String?
  email     String
  phone     String?

  /// CONTACT only — the subject line from the contact form. Always null for QUOTE_REQUEST.
  subject String?
  /// CONTACT: the free-text message. QUOTE_REQUEST: the shipment description/additional notes, if the visitor provided any.
  message String?

  /// QUOTE_REQUEST-only structured shipment details (origin/destination,
  /// mode, item type, dimensions, weight) — kept as a flexible JSON bag
  /// rather than ~10 dedicated nullable columns, the same "event-specific
  /// structured data without a new column per event type" pattern
  /// TrackingEvent.metadata already establishes in this schema. Always
  /// null for CONTACT leads. Never validated/parsed back into a
  /// structured Shipment — purely a staff-readable record of what the
  /// visitor typed.
  quoteDetails Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("website_leads")
}

// ==========================================================================
// SAAS PLATFORM — PLANS, SIGNUP, SUBSCRIPTIONS, ONBOARDING, ENTITLEMENTS
// ==========================================================================
//
// Everything below belongs to the AnanseLogix master SaaS commercial layer,
// not to any tenant's shipping operations — it answers "how does a new
// logistics company become tenant #2, #3, ...": plan selection, the
// pre-payment signup wizard, Stripe subscription billing, per-tenant
// feature entitlements, and the post-payment onboarding wizard. None of
// this is read by the existing shipment/warehouse/container/invoice
// domain. A tenant with no TenantSubscription row (Trans Atlantic,
// bootstrapped directly before this layer existed) is treated as fully
// entitled by application code — see EntitlementsGuard's own doc comment.

/// SOFTWARE_ONLY and WEBSITE_AND_SOFTWARE are retired from public sale (see
/// the SOFTWARE_AND_WEBSITE_BASIC/PROFESSIONAL doc below) but kept — never
/// removed from this enum — so existing SaasPlan/TenantSubscription rows
/// from tenants who bought under the old structure keep resolving cleanly.
enum SaasPlanType {
  WEBSITE_ONLY
  SOFTWARE_ONLY
  WEBSITE_AND_SOFTWARE
  /// Replaces WEBSITE_AND_SOFTWARE as the entry-level combined offering —
  /// same full feature bundle (see plan-entitlements.ts), lower price point.
  SOFTWARE_AND_WEBSITE_BASIC
  /// Same feature bundle as SOFTWARE_AND_WEBSITE_BASIC today; a distinct key
  /// only so the two can be priced/marketed separately and a future admin
  /// can differentiate their entitlements without touching Basic's.
  SOFTWARE_AND_WEBSITE_PROFESSIONAL
}

enum BillingInterval {
  MONTH
}

/// DRAFT/AWAITING_PAYMENT: the wizard is in progress, no Tenant/User exists
/// yet. COMPLETED: TenantProvisioningService has run (triggered from the
/// Stripe webhook — never the frontend success-page redirect, see
/// SignupService's own doc comment). EXPIRED: abandoned before payment,
/// safe to ignore/garbage-collect.
enum SignupSessionStatus {
  DRAFT
  AWAITING_PAYMENT
  COMPLETED
  EXPIRED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
  SUSPENDED
}

enum SetupFeeStatus {
  PENDING
  PAID
  WAIVED
}

enum EntitlementFeature {
  PUBLIC_WEBSITE
  OPERATIONS_SOFTWARE
  CUSTOMER_PORTAL
  TRACKING
  BILLING
  ANALYTICS
  AI_AGENT
  /// Public Website AI Agent, Phase 1: distinct from AI_AGENT (the
  /// authenticated staff Training & Support Agent) — this gates the
  /// unauthenticated, customer-facing widget on a tenant's own public
  /// website. A tenant can have one without the other. See
  /// plan-entitlements.ts for which plans include it by default, and
  /// PublicAiAgentService for the same "no subscription row = grandfathered
  /// true" rule SiteConfigService already established for PUBLIC_WEBSITE.
  PUBLIC_AI_AGENT
  ADVANCED_FEATURES
}

enum OnboardingStep {
  BRANDING
  OPERATIONS
  STAFF
  TRACKING
  NOTIFICATIONS
  BILLING
  DONE
}

enum TenantInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Platform-level triage state for a prospect wanting to become a tenant —
/// deliberately separate from WebsiteLeadStatus (which tracks a shipping
/// customer's inquiry to an existing tenant, a different concern entirely).
enum PlatformLeadStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  TRIAL
  CONVERTED
  LOST
}

enum PlatformLeadSource {
  DIRECT
  CAMPAIGN
  REFERRAL
  SALES_OUTREACH
}

/// A commercial plan a prospect can subscribe to. Pricing itself lives in
/// SaasPlanPrice, kept separate so price history/promos never mutate or
/// lose the plan identity a live TenantSubscription points at.
model SaasPlan {
  id          String       @id @default(cuid())
  key         SaasPlanType @unique
  name        String
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  prices              SaasPlanPrice[]
  signupSessions      SignupSession[]
  tenantSubscriptions TenantSubscription[]

  @@map("saas_plans")
}

/// One priced offer for a SaasPlan at a point in time. Multiple rows per
/// plan accumulate as pricing changes over time (history, never mutated in
/// place); exactly one row per (planId, interval) should have isActive =
/// true at once — enforced by the platform-admin service layer (activating
/// one deactivates the previous row in the same request), not a DB
/// constraint. Checkout always builds Stripe price_data ad-hoc from the
/// active row — the same pattern PaymentsService already uses for invoice
/// Checkout — rather than pre-creating Stripe Price objects that would need
/// to stay in sync with this table.
model SaasPlanPrice {
  id       String          @id @default(cuid())
  planId   String
  interval BillingInterval @default(MONTH)
  currency String          @default("usd")

  setupFeeCents      Int @default(0)
  monthlyAmountCents Int

  trialDays Int @default(0)

  /// Optional promotional override (e.g. a Founding Partner offer) — see
  /// PromoPricingUtil.isPromoActive for the single authoritative
  /// definition of "is the promo currently in effect" (checked by
  /// SaasPlansService for display, SignupService for what Checkout
  /// actually charges, and TenantProvisioningService for redemption
  /// counting — one function, never duplicated). `promoIsActive` is the
  /// admin's own on/off switch, independent of the date window — flipping
  /// it off pauses the promo instantly without touching promoStartsAt/
  /// promoEndsAt. promoLabel is display-only (e.g. "Founding Partner
  /// Pricing"). Never mutated to end a promo — see this model's own
  /// "history, never mutated in place" note above; ending a promo means
  /// creating a new active price row without one, the same way any other
  /// price change works.
  promoLabel              String?
  /// Null means "use the standard setupFeeCents" — a promo can override
  /// the monthly price without also discounting the one-time setup fee,
  /// or vice versa.
  promoSetupFeeCents      Int?
  promoMonthlyAmountCents Int?
  promoStartsAt           DateTime?
  promoEndsAt             DateTime?
  promoIsActive           Boolean   @default(false)
  /// Optional cap on how many subscriptions may redeem this promo — see
  /// promoRedemptionCount. Null means unlimited.
  promoMaxRedemptions     Int?
  /// Incremented exactly once per tenant successfully provisioned while
  /// the promo was active for that signup — see
  /// TenantProvisioningService's own doc comment. Once this reaches
  /// promoMaxRedemptions, isPromoActive() reports false even if
  /// promoIsActive/the date window still say yes, and new signups fall
  /// back to the standard price automatically (the plan stays
  /// purchasable, just no longer at the promo rate).
  promoRedemptionCount    Int       @default(0)
  isFoundingOffer         Boolean   @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  plan          SaasPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions TenantSubscription[]

  @@index([planId])
  @@index([planId, interval, isActive])
  @@map("saas_plan_prices")
}

/// Pre-payment staging for the self-service signup wizard — see
/// SignupSessionStatus's doc comment for the lifecycle. ownerPasswordHash
/// is hashed at Step 2 submit time; the plaintext password is never
/// persisted, even temporarily. companyDetails holds the Step 3 fields as a
/// flexible JSON bag (same "structured data without a dedicated column per
/// field" pattern WebsiteLead.quoteDetails already establishes) since none
/// of it is queried on until TenantProvisioningService turns it into real
/// Tenant/TenantSettings columns.
model SignupSession {
  id     String              @id @default(cuid())
  token  String              @unique
  status SignupSessionStatus @default(DRAFT)

  planId String?

  ownerFirstName    String?
  ownerLastName     String?
  ownerEmail        String?
  ownerPhone        String?
  ownerPasswordHash String?

  companyDetails Json?

  stripeCheckoutSessionId String? @unique

  resultingTenantId String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  plan            SaasPlan? @relation(fields: [planId], references: [id])
  resultingTenant Tenant?   @relation(fields: [resultingTenantId], references: [id])

  @@index([status])
  @@map("signup_sessions")
}

/// The ongoing billing relationship between a tenant and Stripe. One row
/// per tenant (plan changes update this row rather than creating a new
/// one — history isn't tracked yet, see Phase 2 notes in the build plan).
/// stripeSubscriptionId is the idempotency backstop TenantProvisioningService
/// relies on in addition to SignupSession.status, so a retried webhook can
/// never create a second Tenant for the same Stripe subscription.
model TenantSubscription {
  id       String @id @default(cuid())
  tenantId String @unique

  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  planId               String
  /// Which specific SaasPlanPrice row (standard or promo) this tenant
  /// actually signed up under — an audit trail distinct from `planId`
  /// (which only identifies WEBSITE_ONLY/SOFTWARE_ONLY/WEBSITE_AND_SOFTWARE,
  /// not the price paid) and the source of truth
  /// TenantProvisioningService reads to increment
  /// SaasPlanPrice.promoRedemptionCount exactly once. Nullable because a
  /// price row is never deleted (see that model's own doc comment) but
  /// could in principle be deactivated; SetNull rather than Restrict so
  /// that can never block anything on this table.
  priceId              String?
  status               SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?

  setupFeeStatus SetupFeeStatus @default(PENDING)

  cancelAtPeriodEnd Boolean   @default(false)
  /// Set when a payment fails (status becomes PAST_DUE); once now() passes
  /// this timestamp with no successful payment, access is restricted to
  /// SUSPENDED. Checked lazily on each authenticated request (see
  /// jwt.strategy.ts) rather than via a scheduled job — see the Phase 1
  /// build plan for why.
  gracePeriodEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SaasPlan       @relation(fields: [planId], references: [id])
  price  SaasPlanPrice? @relation(fields: [priceId], references: [id], onDelete: SetNull)

  @@map("tenant_subscriptions")
}

/// Per-tenant feature flags, seeded from the chosen SaasPlan's defaults at
/// provisioning time and overridable per-tenant afterward by a platform
/// admin (promo access, manual grants) — see PlatformAuditLog for how those
/// overrides are recorded. Checked by EntitlementsGuard alongside (never
/// instead of) the existing RolesGuard.
model TenantEntitlement {
  id       String             @id @default(cuid())
  tenantId String
  feature  EntitlementFeature
  enabled  Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feature])
  @@index([tenantId])
  @@map("tenant_entitlements")
}

/// Tracks a newly-provisioned tenant's progress through the post-payment
/// onboarding wizard. One row per tenant, created at provisioning time with
/// currentStep = BRANDING.
model TenantOnboarding {
  id       String @id @default(cuid())
  tenantId String @unique

  currentStep OnboardingStep @default(BRANDING)

  brandingCompletedAt      DateTime?
  operationsCompletedAt    DateTime?
  staffInvitedAt           DateTime?
  trackingCompletedAt      DateTime?
  notificationsCompletedAt DateTime?
  completedAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_onboarding")
}

/// An outstanding invitation for someone to join a tenant's staff, created
/// from the onboarding wizard's Staff step (or later from tenant settings).
/// Accepting one creates a real User row through the existing account-
/// creation path — this table never bypasses that.
model TenantInvitation {
  id              String                 @id @default(cuid())
  tenantId        String
  email           String
  role            UserRole
  token           String                 @unique
  status          TenantInvitationStatus @default(PENDING)
  invitedByUserId String

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedByUser User   @relation(fields: [invitedByUserId], references: [id])

  @@index([tenantId])
  @@index([token])
  @@map("tenant_invitations")
}

/// A public, unauthenticated prospect capture from the AnanseLogix
/// marketing site's Demo/Contact form — deliberately separate from
/// WebsiteLead, which is a shipping customer contacting an existing
/// tenant. A PlatformLead is someone who might *become* a tenant; it
/// carries no tenantId because none exists yet, and — like WebsiteLead —
/// never auto-converts into a real Tenant/SignupSession; staff/founders
/// review and act on it manually.
model PlatformLead {
  id     String             @id @default(cuid())
  status PlatformLeadStatus @default(NEW)
  source PlatformLeadSource @default(DIRECT)

  companyName String
  contactName String
  phone       String?
  email       String
  country     String?

  currentWorkflow       String?
  monthlyShipmentVolume String?
  currentSoftware       String?
  servicesOffered       String[]
  message               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("platform_leads")
}

/// Idempotency ledger for Stripe subscription-billing webhook events —
/// keyed on Stripe's own event.id (not a generated one). Subscription
/// billing fans out into several event types (see webhooks.controller.ts),
/// and unlike the single-event one-time-payment flow (which relies solely
/// on Payment.providerReference's uniqueness), some of these — e.g.
/// invoice.paid just updating a status — don't create a new row whose
/// uniqueness would naturally guard a re-run. This table is checked first,
/// before any business-row mutation; domain-level uniques
/// (TenantSubscription.stripeSubscriptionId) remain as defense-in-depth.
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

/// Append-only record of platform-admin actions with billing/account
/// consequences (suspend, reactivate, promo pricing applied) — Section 17's
/// audit-log requirement. Never updated or deleted.
model PlatformAuditLog {
  id                  String   @id @default(cuid())
  platformAdminUserId String
  action              String
  targetTenantId      String?
  metadata            Json?
  createdAt           DateTime @default(now())

  platformAdminUser User    @relation(fields: [platformAdminUserId], references: [id])
  targetTenant      Tenant? @relation(fields: [targetTenantId], references: [id])

  @@index([platformAdminUserId])
  @@index([targetTenantId])
  @@map("platform_audit_logs")
}
