# Copy to .env and fill in real values for local development.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transatlantic_shipping?schema=public"

# HTTP port the NestJS API listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (the web app).
CORS_ORIGIN="http://localhost:3000"

# JWT signing secret and access token lifetime.
# Generate a strong secret for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-change-me-before-deploying"
JWT_EXPIRES_IN="1d"

# bcrypt cost factor for password hashing.
BCRYPT_SALT_ROUNDS=10

# AnanseLogix platform's own Stripe account (test mode) — used for BOTH (A)
# platform SaaS billing (signup subscriptions/setup fees/billing portal,
# via StripeService) AND (B) as the underlying client for every tenant's
# own customer-invoice payments that haven't connected their own Stripe
# account (via TenantPaymentsStripeService — see that file's own doc
# comment on why Stripe Connect means there is no separate "tenant" secret
# key to configure here even once tenants start connecting their own
# accounts). Get both from the Stripe dashboard's Developers > API keys
# (secret key) and Developers > Webhooks, or from `stripe listen` when
# forwarding to a local webhook endpoint (webhook signing secret).
PLATFORM_STRIPE_SECRET_KEY="sk_test_..."
PLATFORM_STRIPE_WEBHOOK_SECRET="whsec_..."
# Platform-billing vs. tenant-customer-payments separation: only needed
# once a tenant has connected their own Stripe account (Connect) — see
# TenantPaymentsStripeService's own doc comment. Stripe issues a distinct
# signing secret for the /webhooks/stripe-connect endpoint; do not reuse
# PLATFORM_STRIPE_WEBHOOK_SECRET here. Unset in every environment today (no
# tenant has connected an account yet) — that's expected, not a
# misconfiguration.
# STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."

# Stage 3F: base URL of the web app, used to build the success/cancel
# redirect URLs Stripe Checkout sends the customer back to.
WEB_APP_URL="http://localhost:3000"

# Multi-tenant branding/routing fix (2026-09): where a tenant-facing link
# (today: the staff invitation Accept Invitation URL — see
# resolveTenantWebAppUrl) points for every tenant that has no
# Tenant.customDomain of its own configured (today, that's every tenant).
# Must be the platform's own hostname, never a specific tenant's — see
# resolveTenantWebAppUrl's own doc comment for the full precedence rules.
ANANSELOGIX_BASE_URL="http://localhost:3000"
# ANANSELOGIX_BASE_URL="https://ananselogix.com" # production

# Names the one tenant WEB_APP_URL above still means "this tenant's own
# domain" for (Trans Atlantic — real production domain
# talogisticssolutions.com, bootstrapped before Tenant.customDomain
# existed as a concept). Config only — never a database write to that
# tenant's row. Leave unset in dev; every tenant then falls through to
# ANANSELOGIX_BASE_URL, which is the correct behavior once this legacy
# tenant's own domain is properly modeled as a customDomain some day.
# LEGACY_CUSTOM_DOMAIN_TENANT_SLUG="transatlantic"

# Stage 3G: document storage. STORAGE_DRIVER selects the active
# StorageProvider: "local" (development, writes to disk) or "r2"
# (production, Cloudflare R2). DOCUMENTS_STORAGE_PATH defaults to
# <repo>/apps/api/storage/documents if unset; override only if you want
# uploaded files written somewhere else in local dev.
STORAGE_DRIVER="local"
# DOCUMENTS_STORAGE_PATH="C:/path/to/storage/documents"

# Website Launch Step 4: Cloudflare R2 (only read when STORAGE_DRIVER="r2").
# From the Cloudflare dashboard: R2 > Overview (Account ID, shown in the
# right sidebar), R2 > Manage R2 API Tokens (Access Key ID / Secret Access
# Key), and the bucket name you created.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""

# Website Launch Step 6: notification email delivery. EMAIL_PROVIDER
# selects the active EmailProvider: "console" (development, just logs)
# or "resend" (production, real delivery via Resend's API). Get
# RESEND_API_KEY from the Resend dashboard > API Keys. EMAIL_FROM_ADDRESS
# defaults to Resend's shared sandbox sender (onboarding@resend.dev),
# which only delivers to the address the Resend account itself was
# created with — sending to arbitrary recipients (e.g. real customers)
# requires verifying a sending domain in Resend (DNS records) and
# setting EMAIL_FROM_ADDRESS to an address on that domain.
EMAIL_PROVIDER="console"
# RESEND_API_KEY=""
# EMAIL_FROM_ADDRESS="onboarding@resend.dev"
# Sender-identity fix (2026-09): optional human-readable sender name shown
# alongside EMAIL_FROM_ADDRESS, e.g. "Trans Atlantic Logistics Solutions"
# so recipients see that instead of a bare address. This pair is scoped to
# TENANT-TO-CUSTOMER mail only (a tenant's own shipment-status
# notifications) — see PLATFORM_EMAIL_FROM_NAME/_ADDRESS below for
# platform-lifecycle mail, which must NEVER use a tenant's name here.
# Omit EMAIL_FROM_NAME to keep today's exact behavior (bare address only).
# EMAIL_FROM_NAME=""

# Sender-identity fix (2026-09, platform-branding): the sender identity for
# platform-lifecycle mail ONLY — staff invitations, password resets,
# billing/signup emails (see platform-emails.ts + resolvePlatformEmailSender)
# — kept deliberately separate from EMAIL_FROM_NAME/EMAIL_FROM_ADDRESS above,
# which are for a tenant's own customer-facing notifications and must never
# leak onto mail sent to a *different* tenant's staff. Defaults to the
# platform's own name ("AnanseLogix") if unset — safe to default in code
# since it's the platform's own identity, never a tenant's.
# PLATFORM_EMAIL_FROM_NAME="AnanseLogix"
# PLATFORM_EMAIL_FROM_ADDRESS is intentionally left unset until a dedicated
# AnanseLogix sending domain is verified with the email provider (SPF/DKIM
# DNS records) — until then, platform mail keeps using whatever address
# EMAIL_FROM_ADDRESS already resolves to (only the display name above
# changes). Set this once that domain exists; no code change is needed.
# PLATFORM_EMAIL_FROM_ADDRESS=""

# WhatsApp Integration (Stage 4C) Phase 1: WHATSAPP_PROVIDER selects the
# active WhatsAppProvider: "console" (development, just logs) or "meta"
# (production, real delivery via Meta's WhatsApp Cloud API). The three
# META_* vars below are only read when WHATSAPP_PROVIDER="meta" — get them
# from the Meta for Developers dashboard (WhatsApp > API Setup) once a
# WhatsApp Business Account is connected: META_WHATSAPP_ACCESS_TOKEN (a
# System User token — not the short-lived temporary token shown on first
# setup), META_WHATSAPP_PHONE_NUMBER_ID (the specific sending number's id,
# not the WABA id), and META_WHATSAPP_BUSINESS_ACCOUNT_ID (needed for
# template management, not for sending itself). Do not set any of these
# in Railway production until a real WhatsApp Business Account, verified
# sending number, and approved message template all exist — see
# meta-whatsapp.provider.ts and whatsapp-template.util.ts for what's
# actually required before a real send can succeed.
WHATSAPP_PROVIDER="console"
# META_WHATSAPP_ACCESS_TOKEN=""
# META_WHATSAPP_PHONE_NUMBER_ID=""
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
# META_WHATSAPP_API_VERSION="v21.0"
# Name/language of the one approved template every supported shipment
# milestone reuses (see buildShipmentStatusWhatsAppTemplate) — must match
# exactly what was submitted for approval in Meta's Message Templates.
# META_WHATSAPP_TEMPLATE_NAME="shipment_status_update"
# META_WHATSAPP_TEMPLATE_LANGUAGE="en_US"

# WhatsApp Integration (Stage 4C) Phase 2: inbound webhook from Meta
# (delivery/read/failed status callbacks for messages this app sent).
# WHATSAPP_WEBHOOK_VERIFY_TOKEN is a value YOU choose (never issued by
# Meta) — enter the exact same value in both Railway and the Meta App
# Dashboard's Webhooks > Callback URL "Verify token" field; Meta echoes it
# back on its one-time verification GET request so this app can confirm
# it's really talking to the callback URL that was configured.
# META_APP_SECRET (Meta App Dashboard > Settings > Basic > App Secret,
# "Show" button) verifies the X-Hub-Signature-256 header on every POST
# webhook delivery — if unset, incoming webhooks are still processed but
# a warning is logged every time (see whatsapp-webhook.controller.ts);
# set this as soon as convenient, not required to complete Meta's initial
# webhook verification step.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# META_APP_SECRET=""

# AnanseLogix Phase 1: the AI Training & Support Agent (Section 11) — a
# pure Q&A chat endpoint answering "how do I..." questions about the
# platform's own workflows, gated by the AI_AGENT tenant entitlement.
# Calls the Claude API directly over fetch (same "no SDK for one HTTP
# call" reasoning as resend-email.provider.ts), so a missing key only
# breaks this one feature, not the whole app. Get an API key from
# https://console.anthropic.com — local/dev only, never set in Railway
# production without separate explicit approval.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"

# Public Website AI Agent, Phase 1 — the unauthenticated, customer-facing
# widget on a tenant's own public website (apps/api/src/public-ai-agent).
# Deliberately a SEPARATE key/budget from the staff agent above: this
# endpoint is public and abuse-exposed in a way the staff one (behind full
# auth + plan entitlement) is not. Provider-agnostic by design — see
# PublicAgentProvider's own doc comment — these two vars are read only by
# AnthropicPublicAgentProvider today; a future non-Anthropic provider would
# read its own separately-named vars instead of these.
# PUBLIC_AI_AGENT_API_KEY=""
# PUBLIC_AI_AGENT_MODEL="claude-sonnet-5"
